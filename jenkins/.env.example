# Copy to .env (git-ignored). On EC2 the CloudFormation stack writes this file for you.
JENKINS_ADMIN_PASSWORD=change-me-to-a-long-password
JENKINS_URL=http://localhost:8080/
# Public Git repo that Jenkins builds
REPO_URL=https://github.com/YOUR_USER/L00205200-propertyhub.git
# Docker Hub repository the image is pushed to (make it public)
DOCKERHUB_REPO=docker.io/YOUR_DOCKERHUB_USER/l00205200-propertyhub
# Deploy target (outputs of the propertyhub CloudFormation stack). Leave blank to skip deploy.
AWS_REGION=us-east-1
EC2_INSTANCE_ID=
APP_URL=
# Host docker group id: getent group docker | cut -d: -f3   (Docker Desktop on Windows/Mac: 0)
DOCKER_GID=999
