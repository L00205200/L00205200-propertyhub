#!/bin/bash
# EC2 user-data: installs k3s, Helm and the monitoring stack (Prometheus, Alertmanager, Grafana, Loki).
# Rendered by Terraform templatefile(): $${...} is a literal bash variable, single-brace dollar terms are Terraform values.
set -euxo pipefail
exec > >(tee -a /var/log/propertyhub-bootstrap.log) 2>&1

# The Elastic IP is attached just after boot: wait until the node can reach the internet
for _ in $(seq 1 60); do curl -s --max-time 5 -o /dev/null https://get.k3s.io && break; sleep 5; done

export DEBIAN_FRONTEND=noninteractive
export HOME=/root
apt-get update -y
apt-get install -y curl git jq unzip ca-certificates

# AWS CLI (used to read the Grafana secret from SSM Parameter Store)
if ! command -v aws >/dev/null 2>&1; then
  snap install aws-cli --classic
fi

# ---------- k3s (lightweight Kubernetes, includes Traefik ingress + metrics-server) ----------
export INSTALL_K3S_CHANNEL="${k3s_channel}"
if [ -n "${k3s_version}" ]; then export INSTALL_K3S_VERSION="${k3s_version}"; fi
curl -sfL https://get.k3s.io | sh -s - --write-kubeconfig-mode 600 --secrets-encryption
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
echo 'export KUBECONFIG=/etc/rancher/k3s/k3s.yaml' > /etc/profile.d/k3s.sh

until kubectl get nodes 2>/dev/null | grep -q " Ready"; do sleep 5; done

# ---------- Helm ----------
curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
helm repo add grafana https://grafana.github.io/helm-charts
helm repo update

# ---------- Secrets: Grafana admin password from SSM -> Kubernetes Secret (never in git) ----------
GRAFANA_PW=$(aws ssm get-parameter --region "${region}" --name "${grafana_param}" --with-decryption \
  --query Parameter.Value --output text)
kubectl create namespace monitoring --dry-run=client -o yaml | kubectl apply -f -
kubectl -n monitoring create secret generic grafana-admin \
  --from-literal=admin-user=admin --from-literal=admin-password="$GRAFANA_PW" \
  --dry-run=client -o yaml | kubectl apply -f -
unset GRAFANA_PW

# ---------- kube-prometheus-stack ----------
cat > /opt/kps-values.yaml <<'EOF'
grafana:
  admin:
    existingSecret: grafana-admin
    userKey: admin-user
    passwordKey: admin-password
  grafana.ini:
    server:
      root_url: "%(protocol)s://%(domain)s/grafana/"
      serve_from_sub_path: true
  ingress:
    enabled: true
    ingressClassName: traefik
    path: /grafana
    hosts: []
  additionalDataSources:
    - name: Loki
      uid: loki
      type: loki
      access: proxy
      url: http://loki.monitoring:3100
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      searchNamespace: ALL
prometheus:
  prometheusSpec:
    retention: 7d
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    resources:
      requests:
        memory: 400Mi
alertmanager:
  alertmanagerSpec:
    resources:
      requests:
        memory: 64Mi
# k3s does not expose these components; disabling avoids false "target down" alerts
kubeEtcd:
  enabled: false
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeProxy:
  enabled: false
EOF

KPS_VERSION_FLAG=""
if [ -n "${kps_version}" ]; then KPS_VERSION_FLAG="--version ${kps_version}"; fi
helm upgrade --install kube-prometheus-stack prometheus-community/kube-prometheus-stack \
  -n monitoring $KPS_VERSION_FLAG -f /opt/kps-values.yaml --wait --timeout 20m

# ---------- Loki + Promtail (log aggregation) ----------
helm upgrade --install loki grafana/loki-stack -n monitoring --version 2.10.2 \
  --set grafana.enabled=false --set prometheus.enabled=false \
  --set promtail.enabled=true --set loki.persistence.enabled=false \
  --wait --timeout 10m

kubectl create namespace propertyhub --dry-run=client -o yaml | kubectl apply -f -

touch /opt/propertyhub-bootstrap-complete
echo "Bootstrap complete"
